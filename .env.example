# 請複製此檔案為 .env 後填入實際的值（.env 不要提交到 git）
# 這裡只放「機密」：API key / token。
# 模型、provider、temperature 等非機密設定請改 config/config.yaml 的 llm: 區塊。

# 必填：Discord Bot Token
DISCORD_BOT_TOKEN="你的_DISCORD_BOT_TOKEN"

# 必填：GEMINI_API_KEY（不論 llm.provider 選哪一家都一定要有）
# 因為向量 Embedding 與 sync_data.py 的表格轉 Markdown 都使用 Gemini；
# 缺少時 main.py 啟動會直接報錯並結束。
GEMINI_API_KEY="你的_GEMINI_API_KEY"

# 以下依 config.yaml 的 llm.provider 擇一填入（只需填你實際使用的那一個）：
#   llm.provider: "groq"    -> GROQ_API_KEY
#   llm.provider: "nvidia"  -> NVIDIA_API_KEY
#   llm.provider: "openai"  -> OPENAI_API_KEY
#   llm.provider: "gemini"  -> 不需額外填寫（使用上面的 GEMINI_API_KEY）
GROQ_API_KEY="你的_GROQ_API_KEY"
NVIDIA_API_KEY="你的_NVIDIA_API_KEY"
OPENAI_API_KEY="你的_OPENAI_API_KEY"
